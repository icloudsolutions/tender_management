<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_tender" model="ir.actions.report">
        <field name="name">Tender Report</field>
        <field name="model">ics.tender</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ics_tender_management.report_tender_document</field>
        <field name="report_file">ics_tender_management.report_tender_document</field>
        <field name="print_report_name">'Tender - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_ics_tender"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_tender_boq" model="ir.actions.report">
        <field name="name">Tender BoQ</field>
        <field name="model">ics.tender</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ics_tender_management.report_tender_boq_document</field>
        <field name="report_file">ics_tender_management.report_tender_boq_document</field>
        <field name="print_report_name">'BoQ - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_ics_tender"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
